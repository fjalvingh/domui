<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee
	      https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">
  <display-name>to.etc.domui.demo</display-name>
  <welcome-file-list>
    <welcome-file>index.html</welcome-file>
    <welcome-file>index.htm</welcome-file>
    <welcome-file>index.jsp</welcome-file>
    <welcome-file>default.html</welcome-file>
    <welcome-file>default.htm</welcome-file>
    <welcome-file>default.jsp</welcome-file>
  </welcome-file-list>
  <!-- 
  	******************************************************
  	This filter declaration is the most important part to get DomUI running. It MUST be mapped to ALL URL's.
   -->
 <filter>
  <filter-name>DomFilter</filter-name>
  <filter-class>to.etc.domui.server.AppFilter</filter-class>
  <init-param>
   <param-name>application</param-name>
   <param-value>to.etc.domuidemo.Application</param-value>
  </init-param>
  <!-- This defines the extension for all DomUI class pages. It defaults to .ui -->
  <init-param>
   <param-name>extension</param-name>
   <param-value>ui</param-value>
  </init-param>
  <!-- This allows changing of pages and page parts at runtime, for quick development. It enables advanced classloading to reload classes that are changed. -->
  <init-param>
   <param-name>auto-reload</param-name>
   <param-value>to\.etc\.domuidemo\.pages.*, to\.etc\.domuidemo\.component.*, .*\.component[s?]\..*, .*\.pages\..*, .*\.fd\..*</param-value>
  </init-param>
 </filter>
 <filter-mapping>
  <filter-name>DomFilter</filter-name>
  <url-pattern>/*</url-pattern>
 </filter-mapping>

 <!--
 	The documentation site at domui.org embeds pages of this application in an
 	iframe (the !demo() tag). That makes this a cross-site frame, so the browser
 	only sends the session cookie back when it is marked SameSite=None, and a
 	SameSite=None cookie is only accepted when it is Secure as well. Without
 	both, DomUI never sees its session and every embedded page shows
 	"Can't create session, session cookie is blocked by the browser!".

 	SameSite (and Partitioned, for browsers that block third party cookies
 	outright) are set on the CookieProcessor in META-INF/context.xml, which
 	Tomcat reads. The Secure flag is set by the listener below: Tomcat ignores
 	session-config/cookie-config/secure and derives the flag from the request
 	being secure, which it never is here because Apache terminates the TLS in
 	front of it.
  -->
 <listener>
  <listener-class>to.etc.domuidemo.SessionCookieSetup</listener-class>
 </listener>
</web-app>
